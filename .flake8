# flake8 configuration for exovista (run: flake8 exovista test examples docs).
#
# Ignored checks:
#   E129  visually indented line with same indent as next logical line
#   E203  whitespace before ':' (conflicts with black-style slices)
#   E221  multiple spaces before operator   (aligned tables in the core)
#   E241  multiple spaces after ','         (aligned tables in the core)
#   E272  multiple spaces before keyword
#   E731  do not assign a lambda expression
#   W503  line break before binary operator (W503/W504 contradict each other)
#   W504  line break after binary operator
# pep8-naming (only if that plugin is installed): the vendored Sandia core
# keeps its lowercase class names (exodusii_file, lineout, ...).
#   N801  class names should use CapWords convention
#   N813  camelcase imported as lowercase
#   N814  camelcase imported as constant
[flake8]
max-line-length = 88
ignore = E129,E203,E221,E241,E272,E731,W503,W504,N801,N813,N814
extend-exclude = build,dist,*.egg-info,.venv,venv,test/data
